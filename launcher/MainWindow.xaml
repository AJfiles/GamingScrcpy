<Window x:Class="GamingScrcpyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GamingScrcpyLauncher"
        Title="{DynamicResource AppTitle}" Height="820" Width="1380"
        MinWidth="1120" MinHeight="600"
        Background="{StaticResource Bg}" Loaded="OnWindowLoaded"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: identity, device, actions. Two rows and no right-aligned
             content inside a shrinking cell: the info column is a star with
             MinWidth=0 and the actions are a WrapPanel, so a narrow window
             reflows instead of drawing the device name over the buttons. -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource Hint}"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,8">
                    <TextBlock Text="{DynamicResource LblLanguage}" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="CboLanguage" Width="110" Margin="0,3,0,0"
                              SelectionChanged="OnLanguageChanged"
                              ToolTip="{DynamicResource HintLanguage}">
                        <ComboBoxItem Content="{DynamicResource LangEs}"/>
                        <ComboBoxItem Content="{DynamicResource LangEn}"/>
                    </ComboBox>
                </StackPanel>

                <!-- Device block and actions share row 1 as two Auto columns
                     with a star filler between them, so the actions stay pinned
                     right while the device block keeps its natural width. The
                     summary line has its own row spanning the full width: as
                     long as it lived in the star cell it could be squeezed to
                     a few pixels and read as an overlap. Window MinWidth below
                     is what keeps the two Auto columns inside the window. -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse x:Name="DevDot" Width="10" Height="10" Fill="{StaticResource Warn}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource LblDevice}" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <ComboBox x:Name="DeviceCombo" MinWidth="170" MaxWidth="300"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="DeviceBadge" Text="{DynamicResource BadgeNoDevice}"
                               Style="{StaticResource Num}" FontFamily="Segoe UI"
                               Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Right" MaxWidth="580" Margin="0,0,0,4">
                    <Button x:Name="BtnRefresh" Content="{DynamicResource BtnRescan}"
                            Click="OnRefreshDevices" Margin="6,0,0,0"/>
                    <Button x:Name="BtnWireless" Content="{DynamicResource BtnWireless}"
                            Click="OnWirelessGuide" Margin="6,0,0,0"/>
                    <Button x:Name="BtnPair" Content="{DynamicResource BtnPair}"
                            Click="OnPairWireless" Margin="6,0,0,0"/>
                    <Button x:Name="BtnConnect" Content="{DynamicResource BtnConnect}"
                            Click="OnConnectWireless" Margin="6,0,0,0"/>
                </WrapPanel>

                <TextBlock x:Name="TxtDeviceSummary" Grid.Row="2" Grid.Column="0"
                           Grid.ColumnSpan="3" Style="{StaticResource Hint}" MinWidth="0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{DynamicResource SummaryNoDevice}"/>
            </Grid>
        </Border>

        <!-- body: tabs keep one job per screen; Advanced holds the rest -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="Transparent" BorderBrush="{StaticResource Line}">
                <TabItem Header="{DynamicResource TabQuick}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SecOneClick}" Style="{StaticResource SectionHeader}"/>
                            <Button x:Name="BtnMirror" Content="{DynamicResource BtnMirror}"
                                    Style="{StaticResource Primary}" Click="OnStartMirror"/>
                            <Button x:Name="BtnMirrorRecord"
                                    Content="{DynamicResource BtnMirrorRecord}"
                                    Style="{StaticResource Record}" Click="OnStartMirrorRecord"/>
                            <Button x:Name="BtnRecordOnly" Content="{DynamicResource BtnRecordOnly}"
                                    Click="OnStartRecordOnly"/>
                            <Button x:Name="BtnStop" Content="{DynamicResource BtnStop}"
                                    Style="{StaticResource Stop}" Click="OnStop"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Text="{DynamicResource HintShortcuts}"/>
                            <Button Content="{DynamicResource SecShortcuts}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Style="{StaticResource Chip}"
                                    Click="OnShowShortcuts"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{DynamicResource SecDevicePanel}"
                                       Style="{StaticResource SectionHeader}"/>
                            <WrapPanel>
                                <TextBlock Text="{DynamicResource LblModel}" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtDeviceModel" Style="{StaticResource Num}"
                                           Text="--" FontFamily="Segoe UI" Margin="0,0,16,0"/>
                                <TextBlock Text="{DynamicResource LblBattery}" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtDeviceBattery" Style="{StaticResource Num}" Text="--"/>
                                <TextBlock Text="{DynamicResource LblTemperature}" Style="{StaticResource FieldLabel}"
                                           Margin="16,0,6,0"/>
                                <TextBlock x:Name="TxtDeviceTemp" Style="{StaticResource Num}" Text="--"/>
                                <Button Content="{DynamicResource BtnRescan}" Margin="16,0,0,0" Width="80"
                                        Style="{StaticResource Chip}" Click="OnRefreshDevice"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource HintDevicePanel}" Style="{StaticResource Hint}"/>

                            <TextBlock Text="{DynamicResource SecPerf}" Style="{StaticResource SectionHeader}"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource LblLiveLatency}" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtPerfLatency" Style="{StaticResource Num}"
                                               FontSize="20" Text="--"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource LblLiveFps}" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtPerfFps" Style="{StaticResource Num}"
                                               FontSize="20" Text="--"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource LblLiveBitrate}" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtPerfVideo" Style="{StaticResource Num}"
                                               FontSize="20" Text="--"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LblLiveAudio}" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtPerfAudio" Style="{StaticResource Num}"
                                               FontSize="20" Text="--"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{DynamicResource HintPerf}" Style="{StaticResource Hint}"/>
                            <Polyline x:Name="PerfSpark" Height="56" Margin="0,8,0,0"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                      Stretch="Fill" Points="0,1 0,1"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource TabCapture}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="{DynamicResource SecCapture}" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource LblVideoCodec}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboVideoCodec" Grid.Row="0" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="h264"/>
                                    <ComboBoxItem Content="{DynamicResource ItemHevc}"/>
                                    <ComboBoxItem Content="av1"/>
                                </ComboBox>
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblCodecNote"
                                           Style="{StaticResource Num}" FontFamily="Segoe UI"
                                           Foreground="{StaticResource FgDim}"
                                           Text="{DynamicResource NoteDeviceHw}"/>
                                <TextBlock Grid.Row="1" Text="{DynamicResource LblBitrate}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboBitrate" Grid.Row="1" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LblBitrate"
                                           Style="{StaticResource Num}" Text="16 Mb/s"/>
                                <TextBlock Grid.Row="6" Text="{DynamicResource LblEncoder}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboEncoderPreset" Grid.Row="6" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"
                                          ToolTip="{DynamicResource TipEncoderPreset}">
                                    <ComboBoxItem Content="{DynamicResource ItemEncoderDefault}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemEncoderUltrafast}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemEncoderFast}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemEncoderMedium}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="6" Grid.Column="2"
                                           Style="{StaticResource Num}" FontFamily="Segoe UI"
                                           Foreground="{StaticResource FgDim}"
                                           Text="{DynamicResource NoteMediaCodec}"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource LblMaxFps}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboMaxFps" Grid.Row="2" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LblMaxFps"
                                           Style="{StaticResource Num}" Text="60 fps"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource LblAudioCodec}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboAudioCodec" Grid.Row="3" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="opus"/>
                                    <ComboBoxItem Content="aac"/>
                                    <ComboBoxItem Content="raw"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Text="{DynamicResource LblAudioBitrate}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboAudioBitrate" Grid.Row="4" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="LblAudioBitrate"
                                           Style="{StaticResource Num}" Text="128 kbps"/>
                                <TextBlock Grid.Row="5" Text="{DynamicResource LblHwdec}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboHwdec" Grid.Row="5" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="{DynamicResource ItemHwAuto}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemHwOff}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemHwD3d}"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{DynamicResource ItemDisabled}" Style="{StaticResource Hint}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource TabPresentation}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="{DynamicResource SecHost}" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource LblRenderer}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboDriver" Grid.Row="0" Grid.Column="1" Margin="0,2">
                                    <ComboBoxItem Content="direct3d11"/>
                                    <ComboBoxItem Content="opengl"/>
                                    <ComboBoxItem Content="vulkan"/>
                                    <ComboBoxItem Content="{DynamicResource ItemRendererDefault}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="{DynamicResource LblUpscale}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboUpscale" Grid.Row="1" Grid.Column="1" Margin="0,2">
                                    <ComboBoxItem Content="{DynamicResource ItemUpscaleLinear}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemUpscalePixel}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemUpscaleNearest}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemUpscaleDefault}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="{DynamicResource LblWindowKernel}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboWindowFilter" Grid.Row="2" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="{DynamicResource ItemWinOff}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemWinLanczos}"/>
                                    <ComboBoxItem Content="bicubic"/>
                                    <ComboBoxItem Content="bilinear"/>
                                    <ComboBoxItem Content="{DynamicResource ItemWinFast}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemWinPoint}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource NoteCpu}"
                                           Style="{StaticResource Hint}"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource LblHostTarget}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboHostPreset" Grid.Row="3" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="{DynamicResource ItemFitAspect}"/>
                                    <ComboBoxItem Content="1920x1080"/>
                                    <ComboBoxItem Content="2560x1440"/>
                                    <ComboBoxItem Content="3840x2160"/>
                                    <ComboBoxItem Content="{DynamicResource ItemFitPortrait1080}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemFitPortrait1440}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Text="{DynamicResource LblFitMode}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboRenderFit" Grid.Row="4" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="letterbox"/>
                                    <ComboBoxItem Content="stretched"/>
                                    <ComboBoxItem Content="unscaled"/>
                                </ComboBox>
                                <TextBlock Grid.Row="5" Text="{DynamicResource LblVideoBuffer}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboVideoBuffer" Grid.Row="5" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="LblVideoBuffer"
                                           Style="{StaticResource Num}" Text="0 ms"/>
                                <TextBlock Grid.Row="6" Text="{DynamicResource LblAudioBuffer}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboAudioOutBuffer" Grid.Row="6" Grid.Column="1"
                                          Margin="0,2" SelectionChanged="OnStepChanged"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="LblAudioOutBuffer"
                                           Style="{StaticResource Num}" Text="120 ms"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="ChkLowLatency" Content="{DynamicResource ChkLowLatency}"
                                          Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkBorderless" Content="{DynamicResource ChkBorderless}"
                                          Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkAlwaysOnTop" Content="{DynamicResource ChkOnTop}"
                                          Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkMipmaps" Content="{DynamicResource ChkMipmaps}"
                                          Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkTouchViz" Content="{DynamicResource ChkTouchViz}"/>
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource LblOsd}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboOsd" Grid.Row="0" Grid.Column="1" Margin="0,2">
                                    <ComboBoxItem Content="{DynamicResource ItemOsdFull}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemOsdCompact}"/>
                                    <ComboBoxItem Content="{DynamicResource ItemOsdNone}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="{DynamicResource LblCursorHide}"
                                           Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldCursorHide" Grid.Row="1" Grid.Column="1"
                                        Minimum="0" Maximum="8000" Value="1500"
                                        ValueChanged="OnSliderChanged"/>
                                <TextBlock x:Name="LblCursorHide" Grid.Row="1" Grid.Column="2"
                                           Style="{StaticResource Num}" Text="1500"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource TabFilters}">
                    <StackPanel Margin="8">
                        <TextBlock Text="{DynamicResource SecFilters}" Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="BtnProfileNeutral" Content="{DynamicResource BtnNeutral}"
                                    Style="{StaticResource Chip}"
                                    Click="OnColorProfile" Tag="neutral"/>
                            <Button x:Name="BtnProfileVivid" Content="{DynamicResource BtnVivid}"
                                    Style="{StaticResource Chip}"
                                    Click="OnColorProfile" Tag="vivid"/>
                            <Button x:Name="BtnProfileCinematic"
                                    Content="{DynamicResource BtnCinematic}"
                                    Style="{StaticResource Chip}"
                                    Click="OnColorProfile" Tag="cinematic"/>
                            <Button x:Name="BtnProfileNight" Content="{DynamicResource BtnNight}"
                                    Style="{StaticResource Chip}"
                                    Click="OnColorProfile" Tag="night"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox x:Name="ChkFxSharp" Content="{DynamicResource LblSharpness}"
                                      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkFxNight" Content="{DynamicResource LblNightBoost}"
                                      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkFxSat" Content="{DynamicResource LblSaturation}"
                                      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkFxContrast" Content="{DynamicResource LblContrast}"
                                      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkFxBright" Content="{DynamicResource LblBrightness}"
                                      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkFxGamma" Content="{DynamicResource LblGamma}"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource LblSharpness}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldSharp" Grid.Row="0" Grid.Column="1" Minimum="0"
                                    Maximum="100" Value="35" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblSharp" Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="35"/>
                            <Button x:Name="BtnResetSharp" Grid.Row="0" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="sharp"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource LblNightBoost}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldNight" Grid.Row="1" Grid.Column="1" Minimum="0"
                                    Maximum="100" Value="40" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblNight" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="40"/>
                            <Button x:Name="BtnResetNight" Grid.Row="1" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="night"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource LblSaturation}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldSat" Grid.Row="2" Grid.Column="1" Minimum="0"
                                    Maximum="200" Value="120" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblSat" Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="120"/>
                            <Button x:Name="BtnResetSat" Grid.Row="2" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="sat"/>
                            <TextBlock Grid.Row="3" Text="{DynamicResource LblContrast}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldContrast" Grid.Row="3" Grid.Column="1" Minimum="0"
                                    Maximum="200" Value="110" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblContrast" Grid.Row="3" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="110"/>
                            <Button x:Name="BtnResetContrast" Grid.Row="3" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="contrast"/>
                            <TextBlock Grid.Row="4" Text="{DynamicResource LblBrightness}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldBright" Grid.Row="4" Grid.Column="1" Minimum="0"
                                    Maximum="200" Value="100" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblBright" Grid.Row="4" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="100"/>
                            <Button x:Name="BtnResetBright" Grid.Row="4" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="bright"/>
                            <TextBlock Grid.Row="5" Text="{DynamicResource LblGamma}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldGamma" Grid.Row="5" Grid.Column="1" Minimum="25"
                                    Maximum="200" Value="100" ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="LblGamma" Grid.Row="5" Grid.Column="2"
                                       Style="{StaticResource Num}" Text="100"/>
                            <Button x:Name="BtnResetGamma" Grid.Row="5" Grid.Column="3"
                                    Content="{DynamicResource BtnResetFilter}"
                                    Style="{StaticResource Chip}" Click="OnResetFilter" Tag="gamma"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{DynamicResource TabRecorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="{DynamicResource SecBridge}" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource LblContainer}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboContainer" Grid.Row="0" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="mkv"/>
                                    <ComboBoxItem Content="mp4"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="{DynamicResource LblRecordFile}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRecordPath" Grid.Row="1" Grid.Column="1"
                                         Margin="0,2"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="…" Width="30"
                                        Margin="6,2,0,2" Click="OnBrowseRecord"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource LblFrameBridge}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtFrameBridge" Grid.Row="2" Grid.Column="1"
                                         Margin="0,2" ToolTip="{DynamicResource TipFrameBridge}"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource LblBridgeScale}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtBridgeScale" Grid.Row="3" Grid.Column="1"
                                         Margin="0,2" ToolTip="{DynamicResource TipBridgeScale}"/>
                                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal"
                                            Margin="6,2,0,2">
                                    <Button Content="1080p" Width="54" Click="OnBridgePreset"
                                            Tag="1920x1080"/>
                                    <Button Content="1440p" Width="58" Margin="4,0,0,0"
                                            Click="OnBridgePreset" Tag="2560x1440"/>
                                    <Button Content="4K" Width="44" Margin="4,0,0,0"
                                            Click="OnBridgePreset" Tag="3840x2160"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="{DynamicResource LblBridgeKernel}"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboBridgeFilter" Grid.Row="4" Grid.Column="1"
                                          Margin="0,2">
                                    <ComboBoxItem Content="lanczos"/>
                                    <ComboBoxItem Content="bicubic"/>
                                    <ComboBoxItem Content="bilinear"/>
                                    <ComboBoxItem Content="fast"/>
                                    <ComboBoxItem Content="point"/>
                                    <ComboBoxItem Content="{DynamicResource ItemUpscaleDefault}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="5" Text="{DynamicResource LblAudioBridge}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAudioBridge" Grid.Row="5" Grid.Column="1"
                                         Margin="0,2" ToolTip="{DynamicResource TipAudioBridge}"/>
                                <TextBlock Grid.Row="6" Text="{DynamicResource LblPcmTap}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAudioPcm" Grid.Row="6" Grid.Column="1"
                                         Margin="0,2" ToolTip="{DynamicResource TipPcmTap}"/>
                                <CheckBox x:Name="ChkPcmMute" Grid.Row="6" Grid.Column="2"
                                          Margin="6,2,0,2" VerticalAlignment="Center"
                                          Content="{DynamicResource ChkMutePc}" ToolTip="{DynamicResource TipMutePc}"/>
                                <TextBlock Grid.Row="7" Text="{DynamicResource LblExtraArgs}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtExtraArgs" Grid.Row="7" Grid.Column="1"
                                         Margin="0,2"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{DynamicResource BtnCopyObs}" Click="OnCopyObsCommand"/>
                                <Button Content="{DynamicResource BtnCopyCommand}" Margin="6,0,0,0"
                                        Click="OnCopyCommand"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Text="{DynamicResource HintBridge}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource TabControl}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource LblKeyboard}"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboKeyboard" Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <ComboBoxItem Content="{DynamicResource ItemAutoDefault}"/>
                                <ComboBoxItem Content="sdk"/>
                                <ComboBoxItem Content="uhid"/>
                                <ComboBoxItem Content="aoa"/>
                                <ComboBoxItem Content="{DynamicResource ItemDisabled}"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="{DynamicResource LblMouse}"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboMouse" Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <ComboBoxItem Content="{DynamicResource ItemAutoDefault}"/>
                                <ComboBoxItem Content="sdk"/>
                                <ComboBoxItem Content="{DynamicResource ItemUhidMouse}"/>
                                <ComboBoxItem Content="aoa"/>
                                <ComboBoxItem Content="{DynamicResource ItemDisabled}"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{DynamicResource LblGamepad}"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboGamepad" Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <ComboBoxItem Content="{DynamicResource ItemDisabled}"/>
                                <ComboBoxItem Content="{DynamicResource ItemUhidAdb}"/>
                                <ComboBoxItem Content="{DynamicResource ItemAoaUsb}"/>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource LblMouseBindings}"
                                       Margin="10,0,0,0" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMouseBindings" Grid.Row="1" Grid.Column="2"
                                     Margin="10,2,0,2" Grid.RowSpan="2"
                                     ToolTip="{DynamicResource TipMouseBindings}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource SecKeymap}"
                                       Style="{StaticResource SectionHeader}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="0,24,0,0">
                                <ListBox x:Name="KeymapList" Height="100"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{DynamicResource BtnApplyKeymap}" Click="OnApplyKeymap"/>
                                    <Button Content="{DynamicResource BtnOpenKeymapDir}" Margin="6,0,0,0"
                                            Click="OnOpenKeymapDir"/>
                                </StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtKeymapHint"
                                                   Text="{DynamicResource HintKeymapDetails}"
                                                   Style="{StaticResource Hint}"/>
                                        <StackPanel x:Name="KeymapDetails"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource TabAdvanced}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="{DynamicResource HintAdvanced}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{DynamicResource SecProfiles}" Style="{StaticResource SectionHeader}"/>
                            <ListBox x:Name="ProfileList" Height="150"
                                     SelectionChanged="OnProfileSelected"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource BtnLoad}"
                                        Click="OnLoadProfile"/>
                                <Button Grid.Column="1" Content="{DynamicResource BtnSaveAs}"
                                        Margin="4,0,0,0" Click="OnSaveProfile"/>
                                <Button Grid.Column="2" Content="{DynamicResource BtnNew}" Margin="4,0,0,0"
                                        Click="OnNewProfile"/>
                                <Button Grid.Column="3" Content="{DynamicResource BtnDelete}"
                                        Margin="4,0,0,0" Click="OnDeleteProfile"/>
                                <Button Grid.Column="4" Content="{DynamicResource BtnExportJson}"
                                        Margin="4,0,0,0" Click="OnExportProfiles"/>
                                <Button Grid.Column="5" Content="{DynamicResource BtnImportJson}"
                                        Margin="4,0,0,0" Click="OnImportProfiles"/>
                            </Grid>
                            <TextBox x:Name="TxtProfileName" Margin="0,6,0,0"
                                     ToolTip="{DynamicResource HintProfileName}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- right rail: what will run, and what happened -->
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource LblCommand}" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCommand" Height="130" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Mono}" FontSize="11"/>
                    <TextBlock Text="{DynamicResource LblRunLog}" Style="{StaticResource SectionHeader}"/>
                </StackPanel>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" FontFamily="{StaticResource Mono}" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- status: three star columns, so a long path is trimmed with a
             tooltip instead of running off the left edge of the window -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="{DynamicResource StatusIdle}"
                           Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                           Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource LblScrcpy}" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="TxtScrcpyPath" Margin="6,0,0,0"
                               Style="{StaticResource Num}" FontFamily="Segoe UI"
                               Foreground="{StaticResource Fg}"
                               Text="{DynamicResource ValNotSet}"
                               MinWidth="0" TextTrimming="CharacterEllipsis"
                               ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LblAdb}" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="TxtAdbPath" Margin="6,0,0,0"
                               Style="{StaticResource Num}" FontFamily="Segoe UI"
                               Foreground="{StaticResource Fg}" Text="{DynamicResource ValNotFound}"
                               MinWidth="0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
