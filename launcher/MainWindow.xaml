<Window x:Class="GamingScrcpyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Scrcpy Launcher" Height="820" Width="1380"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: device detection -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="10"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="GAMING SCRCPY" FontSize="17"
                               FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="host-side presentation fork · device resolution untouched"
                               Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Dispositivo detectado / Detected device"
                               Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="DeviceCombo" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRefresh" Content="Rescan ADB"
                            Click="OnRefreshDevices" Margin="6,0,0,0"/>
                    <Button x:Name="BtnTcpIp" Content="Enable ADB over TCP/IP"
                            Click="OnEnableTcpIp" Margin="6,0,0,0"/>
                    <Button x:Name="BtnPair" Content="Pair wireless"
                            Click="OnPairWireless" Margin="6,0,0,0"/>
                    <Button x:Name="BtnConnect" Content="Connect ip:port"
                            Click="OnConnectWireless" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DeviceBadge" Grid.Column="3" Text="no device"
                           Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- left: quick launch + profiles -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="ONE-CLICK LAUNCH" Style="{StaticResource SectionHeader}"/>
                    <Button x:Name="BtnMirror" Content="▶  Mirror (low latency)"
                            Style="{StaticResource Primary}" Click="OnStartMirror"/>
                    <Button x:Name="BtnMirrorRecord"
                            Content="●  Mirror + auto-record (dual mode)"
                            Style="{StaticResource Record}" Click="OnStartMirrorRecord"/>
                    <Button x:Name="BtnRecordOnly" Content="●  Record only (no window)"
                            Click="OnStartRecordOnly"/>
                    <Button x:Name="BtnStop" Content="■  Stop" Style="{StaticResource Stop}"
                            Click="OnStop"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4"
                               TextWrapping="Wrap"
                               Text="Runtime shortcuts in the mirror window: Super/Alt+F1 cycles the OSD, F2 borderless fullscreen, F3 touch visualizer, F4 cursor, F5 always-on-top."/>

                    <TextBlock Text="PROFILES" Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="ProfileList" Height="150"
                             SelectionChanged="OnProfileSelected"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Load" Click="OnLoadProfile"/>
                        <Button Grid.Column="1" Content="Save as…" Margin="6,0,0,0"
                                Click="OnSaveProfile"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="New" Click="OnNewProfile"/>
                        <Button Grid.Column="1" Content="Delete" Margin="6,0,0,0"
                                Click="OnDeleteProfile"/>
                    </Grid>
                    <TextBox x:Name="TxtProfileName" Margin="0,6,0,0"
                             ToolTip="Profile name"/>

                    <TextBlock Text="KEYMAP / CONTROLLER" Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="KeymapList" Height="100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Apply keymap" Click="OnApplyKeymap"/>
                        <Button Content="Open folder" Margin="6,0,0,0" Click="OnOpenKeymapDir"/>
                    </StackPanel>
                    <Border Background="{StaticResource Panel}" Padding="8" Margin="0,8,0,0"
                            CornerRadius="4">
                        <StackPanel x:Name="KeymapDetails"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- center: configurator -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CAPTURE (device encoder — framebuffer untouched)"
                               Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Video codec"/>
                        <ComboBox x:Name="CboVideoCodec" Grid.Row="0" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="h264"/>
                            <ComboBoxItem Content="hevc (H.265)"/>
                            <ComboBoxItem Content="av1"/>
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblCodecNote"
                                   Style="{StaticResource Hint}" Text="device HW"/>

                        <TextBlock Grid.Row="1" Text="Bitrate (Mbps)"/>
                        <Slider x:Name="SldBitrate" Grid.Row="1" Grid.Column="1"
                                Minimum="2" Maximum="96" TickFrequency="1"
                                Value="16" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LblBitrate"
                                   Text="16 Mb"/>

                        <TextBlock Grid.Row="2" Text="Max FPS"/>
                        <Slider x:Name="SldMaxFps" Grid.Row="2" Grid.Column="1"
                                Minimum="15" Maximum="144" TickFrequency="1"
                                Value="60" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LblMaxFps"
                                   Text="60"/>

                        <TextBlock Grid.Row="3" Text="Audio codec"/>
                        <ComboBox x:Name="CboAudioCodec" Grid.Row="3" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="opus"/>
                            <ComboBoxItem Content="aac"/>
                            <ComboBoxItem Content="raw"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="Audio bitrate (kbps)"/>
                        <Slider x:Name="SldAudioBitrate" Grid.Row="4" Grid.Column="1"
                                Minimum="32" Maximum="512" TickFrequency="16"
                                Value="128" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="LblAudioBitrate"
                                   Text="128"/>
                        <TextBlock Grid.Row="5" Text="Hardware decode"/>
                        <ComboBox x:Name="CboHwdec" Grid.Row="5" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="disabled (software decoding)"/>
                            <ComboBoxItem Content="d3d11va (forced)"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="HOST PRESENTATION (PC side)"
                               Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Renderer"/>
                        <ComboBox x:Name="CboDriver" Grid.Row="0" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="direct3d11"/>
                            <ComboBoxItem Content="opengl"/>
                            <ComboBoxItem Content="vulkan"/>
                            <ComboBoxItem Content="default (SDL picks)"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Upscale filter"/>
                        <ComboBox x:Name="CboUpscale" Grid.Row="1" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="linear (smooth)"/>
                            <ComboBoxItem Content="pixelart (adaptive, retro games)"/>
                            <ComboBoxItem Content="nearest (1:1 pixels)"/>
                            <ComboBoxItem Content="default"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="Window kernel"/>
                        <ComboBox x:Name="CboWindowFilter" Grid.Row="2" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="off (GPU stretches the picture)"/>
                            <ComboBoxItem Content="lanczos (true kernel, ~2.5ms/frame)"/>
                            <ComboBoxItem Content="bicubic"/>
                            <ComboBoxItem Content="bilinear"/>
                            <ComboBoxItem Content="fast (bilinear, cheapest)"/>
                            <ComboBoxItem Content="point (no interpolation)"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="CPU"
                                   Style="{StaticResource Hint}"/>
                        <TextBlock Grid.Row="3" Text="Host target size"/>
                        <ComboBox x:Name="CboHostPreset" Grid.Row="3" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="fit window to device aspect"/>
                            <ComboBoxItem Content="1920x1080 monitor"/>
                            <ComboBoxItem Content="2560x1440 monitor"/>
                            <ComboBoxItem Content="3840x2160 monitor"/>
                            <ComboBoxItem Content="1080x1920 portrait"/>
                            <ComboBoxItem Content="1440x2560 portrait"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="Fit mode"/>
                        <ComboBox x:Name="CboRenderFit" Grid.Row="4" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="letterbox"/>
                            <ComboBoxItem Content="stretched"/>
                            <ComboBoxItem Content="unscaled"/>
                        </ComboBox>
                        <TextBlock Grid.Row="5" Text="Video buffer (ms)"/>
                        <Slider x:Name="SldVideoBuffer" Grid.Row="5" Grid.Column="1"
                                Minimum="0" Maximum="200" Value="0"
                                ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" x:Name="LblVideoBuffer"
                                   Text="0"/>
                        <TextBlock Grid.Row="6" Text="Audio out buffer (ms)"/>
                        <Slider x:Name="SldAudioOutBuffer" Grid.Row="6" Grid.Column="1"
                                Minimum="0" Maximum="500" Value="120"
                                ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" x:Name="LblAudioOutBuffer"
                                   Text="120"/>
                    </Grid>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox x:Name="ChkLowLatency" Content="Low latency (no vsync)"
                                  Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkBorderless" Content="Borderless fullscreen"/>
                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Always on top"
                                  Margin="14,0,0,0"/>
                        <CheckBox x:Name="ChkMipmaps" Content="Mipmaps" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkTouchViz" Content="Touch visualizer"/>
                    </WrapPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OSD telemetry"/>
                        <ComboBox x:Name="CboOsd" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="full (fps, bitrate, latency)"/>
                            <ComboBoxItem Content="compact (fps, latency)"/>
                            <ComboBoxItem Content="none"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="cursor hide" Style="{StaticResource Hint}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cursor auto-hide (ms)"/>
                        <Slider x:Name="SldCursorHide" Grid.Column="1" Minimum="0"
                                Maximum="8000" Value="1500" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="LblCursorHide" Grid.Column="2" Text="1500"/>
                    </Grid>

                    <TextBlock Text="CUSTOM SHADERS / POST (opt-in, costs CPU)"
                               Style="{StaticResource SectionHeader}"/>
                    <WrapPanel>
                        <CheckBox x:Name="ChkFxSharp" Content="CAS sharpen" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkFxNight" Content="Night boost" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkFxSat" Content="Saturation"/>
                    </WrapPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Sharpness %"/>
                        <Slider x:Name="SldSharp" Grid.Row="0" Grid.Column="1" Minimum="0"
                                Maximum="100" Value="35" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="LblSharp" Grid.Row="0" Grid.Column="2" Text="35"/>
                        <TextBlock Grid.Row="1" Text="Shadow lift %"/>
                        <Slider x:Name="SldNight" Grid.Row="1" Grid.Column="1" Minimum="0"
                                Maximum="100" Value="40" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="LblNight" Grid.Row="1" Grid.Column="2" Text="40"/>
                        <TextBlock Grid.Row="2" Text="Saturation %"/>
                        <Slider x:Name="SldSat" Grid.Row="2" Grid.Column="1" Minimum="0"
                                Maximum="200" Value="120" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="LblSat" Grid.Row="2" Grid.Column="2" Text="120"/>
                    </Grid>

                    <TextBlock Text="RECORDER / STREAM BRIDGE"
                               Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Container"/>
                        <ComboBox x:Name="CboContainer" Grid.Row="0" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="mkv"/>
                            <ComboBoxItem Content="mp4"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Record file"/>
                        <TextBox x:Name="TxtRecordPath" Grid.Row="1" Grid.Column="1"
                                 Margin="0,2"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="…" Width="30"
                                Margin="6,2,0,2" Click="OnBrowseRecord"/>
                        <TextBlock Grid.Row="2" Text="Frame bridge"/>
                        <TextBox x:Name="TxtFrameBridge" Grid.Row="2" Grid.Column="1"
                                 Margin="0,2"
                                 ToolTip="\\.\pipe\gaming-frame or a file path or -"/>
                        <TextBlock Grid.Row="3" Text="Bridge scale"/>
                        <TextBox x:Name="TxtBridgeScale" Grid.Row="3" Grid.Column="1"
                                 Margin="0,2"
                                 ToolTip="Exact output size for the bridged feed, e.g. 1920x1080. Empty keeps the device size."/>
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal"
                                    Margin="6,2,0,2">
                            <Button Content="1080p" Width="54" Click="OnBridgePreset" Tag="1920x1080"/>
                            <Button Content="1440p" Width="58" Margin="4,0,0,0" Click="OnBridgePreset" Tag="2560x1440"/>
                            <Button Content="4K" Width="44" Margin="4,0,0,0" Click="OnBridgePreset" Tag="3840x2160"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="Bridge kernel"/>
                        <ComboBox x:Name="CboBridgeFilter" Grid.Row="4" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="lanczos"/>
                            <ComboBoxItem Content="bicubic"/>
                            <ComboBoxItem Content="bilinear"/>
                            <ComboBoxItem Content="fast"/>
                            <ComboBoxItem Content="point"/>
                            <ComboBoxItem Content="default"/>
                        </ComboBox>
                        <TextBlock Grid.Row="5" Text="Audio bridge"/>
                        <TextBox x:Name="TxtAudioBridge" Grid.Row="5" Grid.Column="1"
                                 Margin="0,2"
                                 ToolTip="Encoded packets (opus/aac/raw). Good for a second recorder, useless for a virtual cable."/>
                        <TextBlock Grid.Row="6" Text="PCM tap"/>
                        <TextBox x:Name="TxtAudioPcm" Grid.Row="6" Grid.Column="1"
                                 Margin="0,2"
                                 ToolTip="Decoded audio as s16le / 48 kHz / stereo: what a virtual cable or ffmpeg -f s16le expects. e.g. \\.\pipe\gaming-pcm"/>
                        <CheckBox x:Name="ChkPcmMute" Grid.Row="6" Grid.Column="2"
                                  Margin="6,2,0,2" VerticalAlignment="Center"
                                  Content="mute PC"
                                  ToolTip="Send the game audio only to the PCM tap (--no-audio-playback): OBS hears the cable, your speakers stay quiet."/>
                        <TextBlock Grid.Row="7" Text="Extra scrcpy/ADB args"/>
                        <TextBox x:Name="TxtExtraArgs" Grid.Row="7" Grid.Column="1"
                                 Margin="0,2"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="OBS: copy ffplay command" Click="OnCopyObsCommand"/>
                        <Button Content="Copy command line" Margin="6,0,0,0"
                                Click="OnCopyCommand"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="The frame bridge writes raw RGBA on its own thread with a drop-oldest queue: a slow OBS/FFmpeg consumer can never stall the mirror. A bridge scale resamples that feed (Lanczos/bicubic) to an exact size such as 1920x1080 without touching the device framebuffer or the mirrored window."/>

                    <TextBlock Text="CONTROL" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Keyboard"/>
                        <ComboBox x:Name="CboKeyboard" Grid.Row="0" Grid.Column="1"
                                  Margin="0,2">
                            <ComboBoxItem Content="auto (scrcpy default)"/>
                            <ComboBoxItem Content="sdk"/>
                            <ComboBoxItem Content="uhid"/>
                            <ComboBoxItem Content="aoa"/>
                            <ComboBoxItem Content="disabled"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Mouse"/>
                        <ComboBox x:Name="CboMouse" Grid.Row="1" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="auto (scrcpy default)"/>
                            <ComboBoxItem Content="sdk"/>
                            <ComboBoxItem Content="uhid (mouse capture / FPS aim)"/>
                            <ComboBoxItem Content="aoa"/>
                            <ComboBoxItem Content="disabled"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="Gamepad"/>
                        <ComboBox x:Name="CboGamepad" Grid.Row="2" Grid.Column="1" Margin="0,2">
                            <ComboBoxItem Content="disabled"/>
                            <ComboBoxItem Content="uhid (over ADB)"/>
                            <ComboBoxItem Content="aoa (needs USB AOA)"/>
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Mouse bindings"
                                   Margin="10,0,0,0"/>
                        <TextBox x:Name="TxtMouseBindings" Grid.Row="1" Grid.Column="2"
                                 Margin="10,2,0,2" Grid.RowSpan="2"
                                 ToolTip="4 chars for right/middle/4th/5th click, each one of: + forward, - ignore, b back, h home, s app switch, n notify panel. Optional second sequence after ':' for the Shift+click bindings, e.g. nbsh or bhsn:++++"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- right: command + log -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="COMMAND" Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="TxtCommand" Height="120" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="RUN LOG" Style="{StaticResource SectionHeader}"/>
                </StackPanel>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="8"
                Margin="0,10,0,0" CornerRadius="4">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Idle" Foreground="{StaticResource FgDim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="scrcpy:" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="TxtScrcpyPath" Margin="6,0,18,0"
                               Foreground="{StaticResource Fg}" Text="(not set)"/>
                    <TextBlock Text="adb:" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="TxtAdbPath" Margin="6,0,0,0"
                               Foreground="{StaticResource Fg}" Text="(not found)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
